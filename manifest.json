{
  "manifest_version": 3,
  "name": "Share with Pi",
  "browser_specific_settings": {
    "gecko": {
      "id": "share-with-pi@local",
      "strict_min_version": "128.0"
    }
  },
  "version": "0.2.0",
  "description": "Collect inspected elements from configured origins into a journey and share it with Pi as a local JSON file.",
  "devtools_page": "devtools.html",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["downloads"]
}
